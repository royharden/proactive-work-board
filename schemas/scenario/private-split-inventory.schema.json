{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workboard:v1:scenario:private-split-inventory",
  "title": "PRIVATE split inventory; declarative totals are not admission evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "split": {
      "enum": [
        "dev",
        "heldout"
      ]
    },
    "edition_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Opaque random identifier; no family, eligibility, answer, split or canary encoding."
    },
    "rights": {
      "type": "object",
      "properties": {
        "original_synthetic_only": {
          "const": true
        },
        "no_real_person_or_client_partner_gauntlet_text": {
          "const": true
        },
        "author": {
          "type": "object",
          "properties": {
            "callsign": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "callsign",
            "session_id"
          ],
          "additionalProperties": false
        },
        "redistribution_permission_attestation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "licence_decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "original_synthetic_only",
        "no_real_person_or_client_partner_gauntlet_text",
        "author",
        "redistribution_permission_attestation",
        "licence_decision_ref"
      ],
      "additionalProperties": false
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "description": "Opaque random identifier; no family, eligibility, answer, split or canary encoding."
          },
          "observable_board_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "exogenous_script_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_outcomes_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "focal_count": {
            "type": "integer",
            "minimum": 7,
            "maximum": 10
          },
          "decoy_count": {
            "type": "integer",
            "minimum": 2
          },
          "near_miss_decoy_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "board_id",
          "observable_board_sha256",
          "exogenous_script_sha256",
          "expected_outcomes_sha256",
          "focal_count",
          "decoy_count",
          "near_miss_decoy_count"
        ],
        "additionalProperties": false
      },
      "minItems": 20,
      "maxItems": 20
    },
    "family_totals": {
      "type": "object",
      "properties": {
        "dependency": {
          "const": 32
        },
        "semantic_evidence": {
          "const": 40
        },
        "delegate": {
          "const": 24
        },
        "missing_info_ask": {
          "const": 12
        },
        "decoy": {
          "const": 40
        },
        "duplicate_restraint": {
          "const": 12
        }
      },
      "required": [
        "dependency",
        "semantic_evidence",
        "delegate",
        "missing_info_ask",
        "decoy",
        "duplicate_restraint"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "tasks": {
          "const": 600
        },
        "focal": {
          "const": 160
        },
        "resolution_eligible": {
          "const": 96
        },
        "restraint": {
          "const": 64
        },
        "background": {
          "const": 440
        }
      },
      "required": [
        "tasks",
        "focal",
        "resolution_eligible",
        "restraint",
        "background"
      ],
      "additionalProperties": false
    },
    "dev_seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 20000,
        "maximum": 20019
      },
      "minItems": 20,
      "maxItems": 20
    },
    "generator_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "freeze_utc": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "properties": {
        "callsign": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "callsign",
        "session_id"
      ],
      "additionalProperties": false
    },
    "schedule_salt_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Opaque random identifier; no family, eligibility, answer, split or canary encoding."
    }
  },
  "required": [
    "schema_version",
    "split",
    "edition_id",
    "rights",
    "boards",
    "family_totals",
    "totals",
    "freeze_utc",
    "author",
    "schedule_salt_namespace"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "split": {
            "const": "dev"
          }
        }
      },
      "then": {
        "required": [
          "dev_seeds",
          "generator_commit"
        ],
        "properties": {
          "dev_seeds": {
            "uniqueItems": true
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "dev_seeds"
              ]
            },
            {
              "required": [
                "generator_commit"
              ]
            }
          ]
        }
      }
    }
  ]
}
